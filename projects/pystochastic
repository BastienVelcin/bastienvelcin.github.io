      <pre class="code-block"><code><span class="kw">from</span> pystochastic <span class="kw">import</span> BrownianMotion, EulerMaruyama

<span class="cm"># Simulation d'un mouvement brownien géométrique</span>
process = BrownianMotion(mu=<span class="st">0.05</span>, sigma=<span class="st">0.2</span>)
scheme  = EulerMaruyama(process, dt=<span class="st">0.01</span>, n_steps=<span class="st">1000</span>)
trajectoire = scheme.simulate(n_paths=<span class="st">500</span>)</code></pre>
